n crate required in Rust 2018.\n# fn main() {}\n```\n"},"level":"error","message":"unresolved import `rust::formats::debug_array_user`","spans":[{"byte_end":170,"byte_start":154,"column_end":36,"column_start":20,"expansion":null,"file_name":"tests/test_debug_array_user.rs","is_primary":true,"label":"could not find `debug_array_user` in `formats`","line_end":6,"line_start":6,"suggested_replacement":null,"suggestion_applicability":null,"text":[{"highlight_end":36,"highlight_start":20,"text":"use rust::formats::debug_array_user::*;"}]}]}}
